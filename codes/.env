# Point to your local downloaded models
HF_HOME="/home/spark2/Models"
# Limit CPU threads to prevent RapidFuzz/FAISS from thrashing
OMP_NUM_THREADS="8"
# Ensure CUDA architecture is set for Blackwell compilation
TORCH_CUDA_ARCH_LIST="12.0"
# Prevent wandb from hanging during offline edge runs
WANDB_MODE="offline" 
